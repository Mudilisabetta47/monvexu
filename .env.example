# Kontaktformular (Resend, https://resend.com) – ohne diese Werte zeigt das Formular
# eine freundliche Fehlermeldung statt zu senden.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Kanonische URL der Website (fuer Sitemap, OpenGraph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.monvex-group.de

# KI-Website-Check (/website-check): Anthropic-API-Schlüssel (https://console.anthropic.com). Ohne Schlüssel läuft die automatische
# Analyse vollständig, nur die KI-Einschätzung entfällt.
ANTHROPIC_API_KEY=
# Optional: Modell (Standard: claude-sonnet-5)
ANTHROPIC_MODEL=
